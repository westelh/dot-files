# This is Git's per-user configuration file.
[core]
  autocrlf = input
	editor = nvim
[user]
	name = げ
  email = westelh@gmail.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPFo03y8SED8pK6WW3Yr5fcC4qN5Cug/CQCkQtAwi/X8
[commit]
	verbose = true
	gpgsign = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[include]
  path = .gitconfig.local
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[tag]
	gpgsign = true
